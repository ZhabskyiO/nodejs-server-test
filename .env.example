# Postgres from docker-compose.yml (port 5433 to avoid clashing with other local databases).
DATABASE_URL=postgres://apitest:apitest@localhost:5433/apitest

API_PORT=3005
WEB_PORT=3000
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent — empty falls back to the default.
LOG_LEVEL=

# Background jobs. Always off under NODE_ENV=test, whatever this says.
JOBS_ENABLED=true
# Stale-draft digest: when it runs, how idle a draft must be, and the per-workspace cap.
# Empty CRON falls back to the expression the job registers itself with (`0 3 * * *`).
STALE_DRAFT_CRON=
STALE_DRAFT_AFTER_DAYS=14
STALE_DRAFT_LIMIT=50
